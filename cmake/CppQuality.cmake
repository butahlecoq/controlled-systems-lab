# Actual first-party contexts for the optional developer quality profile.
set(CMAKE_EXPORT_COMPILE_COMMANDS ON CACHE BOOL "Export actual quality commands" FORCE)
# Quality requires explicit configuration and validates every input hash before
# analysis. Avoid forced GLOB regeneration masking Ninja's real pending actions.
set(CMAKE_SUPPRESS_REGENERATION ON)
if(NOT CMAKE_GENERATOR STREQUAL "Ninja")
  message(FATAL_ERROR "CSL_CPP_QUALITY requires the Ninja generator for real dependency evidence")
endif()
if(NOT CSL_CPP_QUALITY_PROFILE MATCHES "^(core|highs|casadi)$")
  message(FATAL_ERROR "Set CSL_CPP_QUALITY_PROFILE to core, highs, or casadi")
endif()

function(csl_quality_json_string output value)
  string(REPLACE "\\" "\\\\" escaped "${value}")
  string(REPLACE "\"" "\\\"" escaped "${escaped}")
  string(REPLACE "\n" "\\n" escaped "${escaped}")
  set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

file(GLOB_RECURSE csl_quality_headers CONFIGURE_DEPENDS LIST_DIRECTORIES false
  "${PROJECT_SOURCE_DIR}/include/csl/*.hpp" "${PROJECT_SOURCE_DIR}/include/csl/*.h"
  "${PROJECT_SOURCE_DIR}/include/csl/*.hxx")
if(NOT csl_quality_headers)
  message(FATAL_ERROR "No public headers for the native quality profile")
endif()
set(csl_quality_header_targets)
set(csl_quality_header_json "{}")
foreach(header IN LISTS csl_quality_headers)
  file(RELATIVE_PATH public_header "${PROJECT_SOURCE_DIR}/include" "${header}")
  string(MAKE_C_IDENTIFIER "${public_header}" identifier)
  set(source "${CMAKE_BINARY_DIR}/cpp-quality-headers/${identifier}.cpp")
  file(GENERATE OUTPUT "${source}" CONTENT "#include <${public_header}>\n")
  add_library(csl_quality_header_${identifier} OBJECT "${source}")
  csl_target_policy(csl_quality_header_${identifier})
  list(APPEND csl_quality_header_targets csl_quality_header_${identifier})
  csl_quality_json_string(quoted_header "include/${public_header}")
  string(JSON csl_quality_header_json SET "${csl_quality_header_json}" "${source}" "${quoted_header}")
endforeach()
add_custom_target(csl_cpp_quality_headers DEPENDS ${csl_quality_header_targets})

# Source edits invalidate the context receipt too. Reconfiguration records the
# new bytes before analysis; a database copied from another tree cannot qualify.
file(READ "${PROJECT_SOURCE_DIR}/scripts/ci/cpp-quality-policy.json" csl_quality_policy)
string(JSON csl_quality_root_count LENGTH "${csl_quality_policy}" roots)
math(EXPR csl_quality_last_root "${csl_quality_root_count} - 1")
set(csl_quality_inputs)
foreach(index RANGE 0 ${csl_quality_last_root})
  string(JSON root GET "${csl_quality_policy}" roots ${index})
  foreach(extension c cc cpp cxx h hpp hxx inl ipp tpp)
    file(GLOB_RECURSE paths CONFIGURE_DEPENDS LIST_DIRECTORIES false
      "${PROJECT_SOURCE_DIR}/${root}/*.${extension}")
    list(APPEND csl_quality_inputs ${paths})
  endforeach()
  file(GLOB_RECURSE owners CONFIGURE_DEPENDS LIST_DIRECTORIES false
    "${PROJECT_SOURCE_DIR}/${root}/*.cmake" "${PROJECT_SOURCE_DIR}/${root}/*CMakeLists.txt")
  list(APPEND csl_quality_inputs ${owners})
endforeach()
file(GLOB_RECURSE csl_quality_cmake_inputs CONFIGURE_DEPENDS LIST_DIRECTORIES false
  "${PROJECT_SOURCE_DIR}/cmake/*.cmake" "${PROJECT_SOURCE_DIR}/cmake/*CMakeLists.txt")
list(APPEND csl_quality_inputs ${csl_quality_cmake_inputs})
list(APPEND csl_quality_inputs "${PROJECT_SOURCE_DIR}/CMakeLists.txt"
  "${PROJECT_SOURCE_DIR}/CMakePresets.json"
  "${PROJECT_SOURCE_DIR}/requirements-cpp-quality.txt"
  "${PROJECT_SOURCE_DIR}/scripts/ci/check_cpp_quality.py"
  "${PROJECT_SOURCE_DIR}/scripts/ci/cpp-quality-policy.json"
  "${PROJECT_SOURCE_DIR}/.clang-format" "${PROJECT_SOURCE_DIR}/.clang-tidy")
list(SORT csl_quality_inputs)
list(REMOVE_DUPLICATES csl_quality_inputs)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${csl_quality_inputs})
set(csl_quality_input_json "{}")
foreach(input IN LISTS csl_quality_inputs)
  file(RELATIVE_PATH relative "${PROJECT_SOURCE_DIR}" "${input}")
  file(SHA256 "${input}" digest)
  csl_quality_json_string(quoted_digest "${digest}")
  string(JSON csl_quality_input_json SET "${csl_quality_input_json}" "${relative}" "${quoted_digest}")
endforeach()

set(csl_quality_profile_json "{}")
foreach(field IN ITEMS schema source_root binary_root profile generator compiler compiler_id compiler_version highs qhull casadi testing)
  if(field STREQUAL "schema")
    set(value "csl.cpp-quality-profile/1")
  elseif(field STREQUAL "source_root")
    set(value "${PROJECT_SOURCE_DIR}")
  elseif(field STREQUAL "binary_root")
    set(value "${CMAKE_BINARY_DIR}")
  elseif(field STREQUAL "profile")
    set(value "${CSL_CPP_QUALITY_PROFILE}")
  elseif(field STREQUAL "generator")
    set(value "${CMAKE_GENERATOR}")
  elseif(field STREQUAL "compiler")
    set(value "${CMAKE_CXX_COMPILER}")
  elseif(field STREQUAL "compiler_id")
    set(value "${CMAKE_CXX_COMPILER_ID}")
  elseif(field STREQUAL "compiler_version")
    set(value "${CMAKE_CXX_COMPILER_VERSION}")
  elseif(field STREQUAL "highs")
    set(value "${CSL_ENABLE_HIGHS}")
  elseif(field STREQUAL "qhull")
    set(value "${CSL_ENABLE_QHULL}")
  elseif(field STREQUAL "casadi")
    set(value "${CSL_ENABLE_CASADI}")
  else()
    set(value "${BUILD_TESTING}")
  endif()
  csl_quality_json_string(quoted_value "${value}")
  string(JSON csl_quality_profile_json SET "${csl_quality_profile_json}" "${field}" "${quoted_value}")
endforeach()
string(JSON csl_quality_profile_json SET "${csl_quality_profile_json}" "inputs_sha256" "${csl_quality_input_json}")
string(JSON csl_quality_profile_json SET "${csl_quality_profile_json}" "public_header_contexts" "${csl_quality_header_json}")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/cpp-quality-profile.json" CONTENT "${csl_quality_profile_json}\n")
cmake_file_api(QUERY API_VERSION 1 CODEMODEL 2 CACHE 2 CMAKEFILES 1 TOOLCHAINS 1)
