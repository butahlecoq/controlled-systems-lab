if(NOT DEFINED SOURCE_FILE OR NOT EXISTS "${SOURCE_FILE}")
  message(FATAL_ERROR "Pinned HiGHS Highs.h is missing")
endif()

file(READ "${SOURCE_FILE}" source)
string(REPLACE "\r\n" "\n" logical_source "${source}")
string(SHA256 source_sha256 "${logical_source}")
set(upstream_sha256 "5e81b644fad40522a62037b0dab8ae0f023a8f7db7540297030ac28de58b56cc")
set(patched_sha256 "9e6849f8933e3e434c5964f78f2c7229537a9398f1d6ded35a2cd2c5d1839501")
set(original_declaration "  HighsInt getNumSchedulerThreads() const { return max_threads; }")
if(source MATCHES "\r\n")
  set(line_ending "\r\n")
else()
  set(line_ending "\n")
endif()
set(clock_declaration "  struct ClockRecordForDiagnostics {\n    HighsInt id;\n    std::string name;\n    HighsInt calls;\n    double seconds;\n  };\n\n  std::vector<ClockRecordForDiagnostics> getClockRecordsForDiagnostics() const {\n    std::vector<ClockRecordForDiagnostics> records;\n    records.reserve(static_cast<size_t>(timer_.num_clock));\n    for (HighsInt id = 0; id < timer_.num_clock; ++id)\n      records.push_back({id, timer_.clock_names[id], timer_.clock_num_call[id],\n                         timer_.read(id)});\n    return records;\n  }")
string(REPLACE "\n" "${line_ending}" clock_declaration "${clock_declaration}")
set(patched_declaration "${original_declaration}${line_ending}${line_ending}${clock_declaration}")

string(FIND "${source}" "${patched_declaration}" patched_position)
if(NOT patched_position EQUAL -1)
  if(NOT source_sha256 STREQUAL patched_sha256)
    message(FATAL_ERROR "Patched HiGHS Highs.h has an unexpected clock accessor hash: ${source_sha256}")
  endif()
  return()
endif()
if(NOT source_sha256 STREQUAL upstream_sha256)
  message(FATAL_ERROR "Pinned HiGHS Highs.h has an unexpected clock patch state: ${source_sha256}")
endif()

string(FIND "${source}" "${original_declaration}" original_position)
if(original_position EQUAL -1)
  message(FATAL_ERROR "Pinned HiGHS clock accessor anchor is missing")
endif()
string(REPLACE "${original_declaration}" "${patched_declaration}" source "${source}")
string(REPLACE "\r\n" "\n" logical_patched_source "${source}")
string(SHA256 actual_patched_sha256 "${logical_patched_source}")
if(NOT actual_patched_sha256 STREQUAL patched_sha256)
  message(FATAL_ERROR "Pinned HiGHS clock patch produced an unexpected hash: ${actual_patched_sha256}")
endif()
file(WRITE "${SOURCE_FILE}" "${source}")
