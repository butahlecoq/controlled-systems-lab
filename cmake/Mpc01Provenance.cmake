include_guard(GLOBAL)

function(csl_mpc01_attach_provenance target)
  execute_process(COMMAND git rev-parse HEAD
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    OUTPUT_VARIABLE CSL_MPC01_SOURCE_COMMIT
    OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND git diff --binary HEAD --
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    OUTPUT_VARIABLE CSL_MPC01_TRACKED_DIFF
    COMMAND_ERROR_IS_FATAL ANY)
  string(SHA256 CSL_MPC01_TRACKED_DIFF_SHA256 "${CSL_MPC01_TRACKED_DIFF}")
  execute_process(COMMAND git ls-files --others --exclude-standard
    WORKING_DIRECTORY "${PROJECT_SOURCE_DIR}"
    OUTPUT_VARIABLE CSL_MPC01_UNTRACKED_FILES
    OUTPUT_STRIP_TRAILING_WHITESPACE
    COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "\n" ";" CSL_MPC01_UNTRACKED_FILES "${CSL_MPC01_UNTRACKED_FILES}")
  set(CSL_MPC01_UNTRACKED_MATERIAL "")
  foreach(CSL_MPC01_FILE IN LISTS CSL_MPC01_UNTRACKED_FILES)
    if(CSL_MPC01_FILE MATCHES "^docs/research/evidence/mpc01-external-qps-[^/]+/")
      continue()
    endif()
    if(NOT CSL_MPC01_FILE STREQUAL "" AND EXISTS "${PROJECT_SOURCE_DIR}/${CSL_MPC01_FILE}" AND
       NOT IS_DIRECTORY "${PROJECT_SOURCE_DIR}/${CSL_MPC01_FILE}")
      file(SHA256 "${PROJECT_SOURCE_DIR}/${CSL_MPC01_FILE}" CSL_MPC01_FILE_SHA256)
      string(APPEND CSL_MPC01_UNTRACKED_MATERIAL "${CSL_MPC01_FILE}:${CSL_MPC01_FILE_SHA256}\n")
    endif()
  endforeach()
  string(SHA256 CSL_MPC01_UNTRACKED_SHA256 "${CSL_MPC01_UNTRACKED_MATERIAL}")
  string(SHA256 CSL_MPC01_SOURCE_TREE_SHA256
    "${CSL_MPC01_SOURCE_COMMIT}:${CSL_MPC01_TRACKED_DIFF_SHA256}:${CSL_MPC01_UNTRACKED_SHA256}")
  if(CSL_MPC01_TRACKED_DIFF STREQUAL "" AND CSL_MPC01_UNTRACKED_MATERIAL STREQUAL "")
    set(CSL_MPC01_SOURCE_DIRTY 0)
  else()
    set(CSL_MPC01_SOURCE_DIRTY 1)
  endif()

  string(SHA256 CSL_MPC01_C_FLAGS_SHA256
    "${CMAKE_C_FLAGS} ${CMAKE_C_FLAGS_RELEASE}")
  string(SHA256 CSL_MPC01_CXX_FLAGS_SHA256
    "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_RELEASE}")
  string(SHA256 CSL_MPC01_LINK_FLAGS_SHA256
    "${CMAKE_EXE_LINKER_FLAGS} ${CMAKE_EXE_LINKER_FLAGS_RELEASE}")
  if(MSVC)
    set(CSL_MPC01_TARGET_FLAGS "/W4 /WX /permissive-")
  else()
    set(CSL_MPC01_TARGET_FLAGS "-Wall -Wextra -Wpedantic -Werror")
  endif()
  string(SHA256 CSL_MPC01_TARGET_FLAGS_SHA256 "${CSL_MPC01_TARGET_FLAGS}")

  set(CSL_MPC01_OSQP_VERSION "")
  set(CSL_MPC01_OSQP_SHA256 "")
  set(CSL_MPC01_HPIPM_VERSION "")
  set(CSL_MPC01_HPIPM_SHA256 "")
  set(CSL_MPC01_BLASFEO_VERSION "")
  set(CSL_MPC01_BLASFEO_SHA256 "")
  set(CSL_MPC01_CURRENT_DEPENDENCY "")
  file(STRINGS "${PROJECT_SOURCE_DIR}/benchmarks/reporting/mpc01/native/CMakeLists.txt"
    CSL_MPC01_NATIVE_CMAKE_LINES)
  foreach(CSL_MPC01_LINE IN LISTS CSL_MPC01_NATIVE_CMAKE_LINES)
    if(CSL_MPC01_LINE MATCHES "FetchContent_Declare\\(csl_mpc01_(osqp|hpipm|blasfeo)")
      set(CSL_MPC01_CURRENT_DEPENDENCY "${CMAKE_MATCH_1}")
    elseif(CSL_MPC01_LINE MATCHES "URL .*/refs/tags/v([0-9]+\\.[0-9]+\\.[0-9]+)")
      set(CSL_MPC01_OSQP_VERSION "${CMAKE_MATCH_1}")
    elseif(CSL_MPC01_LINE MATCHES "URL .*/([0-9a-f]+)$")
      string(LENGTH "${CMAKE_MATCH_1}" CSL_MPC01_REVISION_LENGTH)
      if(CSL_MPC01_REVISION_LENGTH EQUAL 40 AND CSL_MPC01_CURRENT_DEPENDENCY STREQUAL "hpipm")
        set(CSL_MPC01_HPIPM_VERSION "${CMAKE_MATCH_1}")
      elseif(CSL_MPC01_REVISION_LENGTH EQUAL 40 AND CSL_MPC01_CURRENT_DEPENDENCY STREQUAL "blasfeo")
        set(CSL_MPC01_BLASFEO_VERSION "${CMAKE_MATCH_1}")
      endif()
    elseif(CSL_MPC01_LINE MATCHES "URL_HASH SHA256=([0-9a-f]+)")
      if(CSL_MPC01_CURRENT_DEPENDENCY STREQUAL "osqp")
        set(CSL_MPC01_OSQP_SHA256 "${CMAKE_MATCH_1}")
      elseif(CSL_MPC01_CURRENT_DEPENDENCY STREQUAL "hpipm")
        set(CSL_MPC01_HPIPM_SHA256 "${CMAKE_MATCH_1}")
      elseif(CSL_MPC01_CURRENT_DEPENDENCY STREQUAL "blasfeo")
        set(CSL_MPC01_BLASFEO_SHA256 "${CMAKE_MATCH_1}")
      endif()
    endif()
  endforeach()
  foreach(CSL_MPC01_REQUIRED IN ITEMS
      CSL_MPC01_SOURCE_COMMIT CSL_MPC01_SOURCE_TREE_SHA256 CSL_MPC01_OSQP_VERSION
      CSL_MPC01_OSQP_SHA256 CSL_MPC01_HPIPM_VERSION CSL_MPC01_HPIPM_SHA256
      CSL_MPC01_BLASFEO_VERSION CSL_MPC01_BLASFEO_SHA256)
    if("${${CSL_MPC01_REQUIRED}}" STREQUAL "")
      message(FATAL_ERROR "Could not capture required MPC-01 provenance field ${CSL_MPC01_REQUIRED}")
    endif()
  endforeach()

  if(CMAKE_SYSTEM_PROCESSOR STREQUAL "")
    set(CSL_MPC01_ARCHITECTURE "${CMAKE_HOST_SYSTEM_PROCESSOR}")
  else()
    set(CSL_MPC01_ARCHITECTURE "${CMAKE_SYSTEM_PROCESSOR}")
  endif()

  target_compile_definitions(${target} PRIVATE
    CSL_MPC01_SOURCE_COMMIT="${CSL_MPC01_SOURCE_COMMIT}"
    CSL_MPC01_SOURCE_TREE_SHA256="${CSL_MPC01_SOURCE_TREE_SHA256}"
    CSL_MPC01_SOURCE_DIRTY=${CSL_MPC01_SOURCE_DIRTY}
    CSL_MPC01_COMPILER_ID="${CMAKE_CXX_COMPILER_ID}"
    CSL_MPC01_COMPILER_VERSION="${CMAKE_CXX_COMPILER_VERSION}"
    CSL_MPC01_GENERATOR="${CMAKE_GENERATOR}"
    CSL_MPC01_ARCHITECTURE="${CSL_MPC01_ARCHITECTURE}"
    CSL_MPC01_BUILD_TYPE=\"$<CONFIG>\"
    CSL_MPC01_C_FLAGS_SHA256="${CSL_MPC01_C_FLAGS_SHA256}"
    CSL_MPC01_CXX_FLAGS_SHA256="${CSL_MPC01_CXX_FLAGS_SHA256}"
    CSL_MPC01_LINK_FLAGS_SHA256="${CSL_MPC01_LINK_FLAGS_SHA256}"
    CSL_MPC01_TARGET_FLAGS_SHA256="${CSL_MPC01_TARGET_FLAGS_SHA256}"
    CSL_MPC01_OSQP_VERSION="${CSL_MPC01_OSQP_VERSION}"
    CSL_MPC01_OSQP_SHA256="${CSL_MPC01_OSQP_SHA256}"
    CSL_MPC01_HPIPM_VERSION="${CSL_MPC01_HPIPM_VERSION}"
    CSL_MPC01_HPIPM_SHA256="${CSL_MPC01_HPIPM_SHA256}"
    CSL_MPC01_BLASFEO_VERSION="${CSL_MPC01_BLASFEO_VERSION}"
    CSL_MPC01_BLASFEO_SHA256="${CSL_MPC01_BLASFEO_SHA256}")
endfunction()
