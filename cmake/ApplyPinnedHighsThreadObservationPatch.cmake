if(NOT DEFINED SOURCE_FILE OR NOT EXISTS "${SOURCE_FILE}")
  message(FATAL_ERROR "Pinned HiGHS Highs.h is missing")
endif()

file(READ "${SOURCE_FILE}" source)
string(REPLACE "\r\n" "\n" logical_source "${source}")
string(SHA256 source_sha256 "${logical_source}")
set(upstream_sha256 "f1b8e2e3f59d9bb96170574e81e9cfc464a16ecfaf1e7ccc64575798ecfb98e2")
set(patched_sha256 "5e81b644fad40522a62037b0dab8ae0f023a8f7db7540297030ac28de58b56cc")
set(original_declaration "  static void resetGlobalScheduler(bool blocking = false);")
if(source MATCHES "\r\n")
  set(line_ending "\r\n")
else()
  set(line_ending "\n")
endif()
set(patched_declaration "  static void resetGlobalScheduler(bool blocking = false);${line_ending}${line_ending}  // Returns the scheduler width recorded by the most recent optimizeModel call.${line_ending}  HighsInt getNumSchedulerThreads() const { return max_threads; }")
string(FIND "${source}" "${patched_declaration}" patched_position)
if(NOT patched_position EQUAL -1)
  if(NOT source_sha256 STREQUAL patched_sha256)
    message(FATAL_ERROR "Patched HiGHS Highs.h has an unexpected content hash: ${source_sha256}")
  endif()
  return()
endif()
if(NOT source_sha256 STREQUAL upstream_sha256)
  message(FATAL_ERROR "Pinned HiGHS Highs.h has an unexpected content hash: ${source_sha256}")
endif()
string(FIND "${source}" "${original_declaration}" original_position)
if(original_position EQUAL -1)
  message(FATAL_ERROR "Pinned HiGHS Highs.h has an unexpected patch state")
endif()
string(REPLACE "${original_declaration}" "${patched_declaration}" source "${source}")
string(FIND "${source}" "${patched_declaration}" patched_position)
if(patched_position EQUAL -1)
  message(FATAL_ERROR "Pinned HiGHS scheduler accessor patch did not apply")
endif()
string(REPLACE "\r\n" "\n" logical_source "${source}")
string(SHA256 patched_source_sha256 "${logical_source}")
if(NOT patched_source_sha256 STREQUAL patched_sha256)
  message(FATAL_ERROR "Pinned HiGHS scheduler accessor patch produced an unexpected hash: ${patched_source_sha256}")
endif()
file(WRITE "${SOURCE_FILE}" "${source}")
