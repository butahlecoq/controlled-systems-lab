option(CSL_BUILD_REPORTS "Build the non-installed algorithm report driver" OFF)
if(BUILD_TESTING OR CSL_BUILD_REPORTS)
  execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
    OUTPUT_VARIABLE REPORT_SOURCE_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  string(SHA256 REPORT_BUILD_OWNER "${CMAKE_CURRENT_SOURCE_DIR}\n${CMAKE_CURRENT_BINARY_DIR}\n${CMAKE_CXX_COMPILER}")
  configure_file(cmake/ReportBuildInfo.hpp.in ${CMAKE_CURRENT_BINARY_DIR}/report-generated/ReportBuildInfo.hpp @ONLY)
  cmake_file_api(QUERY API_VERSION 1 CODEMODEL 2 TOOLCHAINS 1)
  file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/report-build-info.json
    "{\"schema\":\"csl.report-build/1\",\"source_commit\":\"${REPORT_SOURCE_COMMIT}\",\"file_api\":\".cmake/api/v1/reply\"}\n")
  add_library(csl_report_runtime STATIC benchmarks/reporting/report_runtime.cpp benchmarks/reporting/process_counters.cpp)
  target_include_directories(csl_report_runtime PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/benchmarks/reporting)
  target_include_directories(csl_report_runtime PRIVATE ${CMAKE_CURRENT_BINARY_DIR}/report-generated)
  target_compile_definitions(csl_report_runtime PRIVATE CSL_REPORT_CONFIG="$<CONFIG>")
  target_link_libraries(csl_report_runtime PUBLIC CSL::numeric CSL::contracts)
  if(WIN32)
    target_link_libraries(csl_report_runtime PRIVATE Psapi)
  endif()
  target_compile_features(csl_report_runtime PUBLIC cxx_std_20)
  add_library(csl_report_support STATIC benchmarks/reporting/lp_report.cpp)
  target_link_libraries(csl_report_support PUBLIC CSL::highs_lp csl_report_runtime)
  add_library(csl_convex_report_support STATIC benchmarks/reporting/convex_report.cpp)
  target_link_libraries(csl_convex_report_support PUBLIC CSL::highs_convex csl_report_runtime)
  add_executable(csl_lp_report benchmarks/reporting/lp_report_main.cpp)
  target_link_libraries(csl_lp_report PRIVATE csl_report_support)
  add_executable(csl_convex_report benchmarks/reporting/convex_report_main.cpp)
  target_link_libraries(csl_convex_report PRIVATE csl_convex_report_support)
  foreach(report_target csl_report_runtime csl_report_support csl_convex_report_support csl_lp_report csl_convex_report)
    if(MSVC)
      target_compile_options(${report_target} PRIVATE /W4 /WX /permissive-)
    else()
      target_compile_options(${report_target} PRIVATE -Wall -Wextra -Wpedantic -Werror)
    endif()
  endforeach()
  if(BUILD_TESTING)
    find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
    add_executable(convex_report_tests tests/reporting/convex_report_tests.cpp)
    target_link_libraries(convex_report_tests PRIVATE csl_convex_report_support doctest::doctest)
    add_test(NAME convex_report_tests COMMAND convex_report_tests)
    add_test(NAME convex_report_data_tests COMMAND ${Python3_EXECUTABLE} -m unittest discover -s ${CMAKE_CURRENT_SOURCE_DIR}/tests/reporting -p test_convex_report.py)
    add_test(NAME convex_report_smoke COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/reporting/test_convex_report.py --exe $<TARGET_FILE:csl_convex_report>)
    set_tests_properties(convex_report_tests convex_report_data_tests convex_report_smoke PROPERTIES TIMEOUT 90)
    add_executable(lp_report_tests tests/reporting/lp_report_tests.cpp)
    target_link_libraries(lp_report_tests PRIVATE csl_report_support doctest::doctest)
    add_test(NAME lp_report_tests COMMAND lp_report_tests)
    set_tests_properties(lp_report_tests PROPERTIES TIMEOUT 60)
    add_test(NAME report_data_tests COMMAND ${Python3_EXECUTABLE} -m unittest discover -s ${CMAKE_CURRENT_SOURCE_DIR}/tests/reporting -p test_report_data.py)
    add_test(NAME report_render_tests COMMAND ${Python3_EXECUTABLE} -m unittest discover -s ${CMAKE_CURRENT_SOURCE_DIR}/tests/reporting -p test_render.py)
    add_test(NAME report_smoke COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/tests/reporting/test_smoke.py --exe $<TARGET_FILE:csl_lp_report>)
    set_tests_properties(report_data_tests report_render_tests report_smoke PROPERTIES TIMEOUT 90)
  endif()
endif()
