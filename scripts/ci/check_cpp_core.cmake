cmake_minimum_required(VERSION 3.31)

get_filename_component(source_root "${CMAKE_CURRENT_LIST_DIR}/../.." REALPATH)
set(llvm_version "23.1.3")
if(NOT DEFINED CSL_CPP_QUALITY_MODE)
  set(CSL_CPP_QUALITY_MODE all)
endif()
if(NOT CSL_CPP_QUALITY_MODE MATCHES "^(all|format|tidy)$")
  message(FATAL_ERROR "CSL_CPP_QUALITY_MODE must be all, format, or tidy")
endif()

function(require_tool_version executable)
  execute_process(COMMAND "${executable}" --version OUTPUT_VARIABLE version
    ERROR_VARIABLE version_error COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "." "\\." version_pattern "${llvm_version}")
  if(NOT "${version}${version_error}" MATCHES "(^|[^0-9])${version_pattern}([^0-9.]|$)")
    message(FATAL_ERROR "${executable} must be LLVM ${llvm_version}; install requirements-cpp-quality.txt")
  endif()
endfunction()

file(GLOB_RECURSE core_headers LIST_DIRECTORIES false "${source_root}/include/csl/core/*.hpp")
if(NOT core_headers)
  message(FATAL_ERROR "No maintained C++ core headers found")
endif()
set(outcomes_source "${source_root}/src/contracts/outcomes.cpp")
set(nominal_headers)
set(nominal_sources)
foreach(module nominal_forward nominal_predecessor nominal_tube)
  list(APPEND nominal_headers "${source_root}/include/csl/reachability/${module}.hpp")
  list(APPEND nominal_sources "${source_root}/src/reachability/${module}.cpp")
endforeach()
set(numeric_header "${source_root}/include/csl/numeric/data.hpp")
set(numeric_source "${source_root}/src/numeric/data.cpp")
set(quality_headers ${core_headers} ${nominal_headers} "${numeric_header}")
set(format_sources ${quality_headers} "${outcomes_source}" ${nominal_sources} "${numeric_source}")

if(NOT CSL_CPP_QUALITY_MODE STREQUAL tidy)
  find_program(CSL_CLANG_FORMAT NAMES clang-format REQUIRED)
  require_tool_version("${CSL_CLANG_FORMAT}")
  execute_process(COMMAND "${CSL_CLANG_FORMAT}" --style=file --dry-run --Werror ${format_sources}
    WORKING_DIRECTORY "${source_root}" COMMAND_ERROR_IS_FATAL ANY)
endif()
if(CSL_CPP_QUALITY_MODE STREQUAL format)
  return()
endif()

find_program(CSL_CLANG_TIDY NAMES clang-tidy REQUIRED)
require_tool_version("${CSL_CLANG_TIDY}")
if(NOT DEFINED CSL_CPP_QUALITY_BUILD_DIR)
  set(CSL_CPP_QUALITY_BUILD_DIR "${source_root}/build/cpp-quality")
endif()
file(REAL_PATH "${CSL_CPP_QUALITY_BUILD_DIR}" build_root BASE_DIRECTORY "${source_root}")
if(NOT EXISTS "${build_root}/CMakeCache.txt" OR NOT EXISTS "${build_root}/compile_commands.json")
  message(FATAL_ERROR "Configure the core profile with CMAKE_EXPORT_COMPILE_COMMANDS=ON first")
endif()
file(STRINGS "${build_root}/CMakeCache.txt" owner REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
string(REPLACE "CMAKE_HOME_DIRECTORY:INTERNAL=" "" owner "${owner}")
file(REAL_PATH "${owner}" configured_source)
if(NOT configured_source STREQUAL source_root)
  message(FATAL_ERROR "Compilation database belongs to another source tree: ${configured_source}")
endif()

file(READ "${build_root}/compile_commands.json" database)
string(JSON command_count LENGTH "${database}")
math(EXPR last_command "${command_count} - 1")
set(compiled_sources)
if(command_count GREATER 0)
  foreach(index RANGE 0 ${last_command})
    string(JSON compiled_source GET "${database}" ${index} file)
    string(JSON directory GET "${database}" ${index} directory)
    file(REAL_PATH "${compiled_source}" compiled_source BASE_DIRECTORY "${directory}")
    list(APPEND compiled_sources "${compiled_source}")
  endforeach()
endif()

set(analysis_sources "${outcomes_source}" ${nominal_sources} "${numeric_source}")
foreach(header IN LISTS quality_headers)
  file(RELATIVE_PATH relative "${source_root}/include/csl" "${header}")
  string(MAKE_C_IDENTIFIER "${relative}" identifier)
  set(header_source "${build_root}/header-checks/${identifier}.cpp")
  if(NOT EXISTS "${header_source}")
    message(FATAL_ERROR "No standalone CMake context for ${relative}; register the header in its module's Tests.cmake")
  endif()
  list(APPEND analysis_sources "${header_source}")
endforeach()
foreach(source IN LISTS analysis_sources)
  if(NOT source IN_LIST compiled_sources)
    message(FATAL_ERROR "Missing real compilation command for ${source}")
  endif()
  message(STATUS "clang-tidy ${llvm_version}: ${source}")
  execute_process(COMMAND "${CSL_CLANG_TIDY}" "-p=${build_root}"
    "--config-file=${source_root}/.clang-tidy" --quiet "${source}"
    WORKING_DIRECTORY "${source_root}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
