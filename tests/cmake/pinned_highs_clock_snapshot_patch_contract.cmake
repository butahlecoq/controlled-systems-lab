if(NOT DEFINED PATCHED_HEADER OR NOT EXISTS "${PATCHED_HEADER}")
  message(FATAL_ERROR "Patched HiGHS Highs.h is missing")
endif()
if(NOT DEFINED PATCH_SCRIPT OR NOT EXISTS "${PATCH_SCRIPT}")
  message(FATAL_ERROR "HiGHS clock snapshot patch script is missing")
endif()
if(NOT DEFINED WORK_DIR)
  message(FATAL_ERROR "WORK_DIR is required")
endif()

file(READ "${PATCHED_HEADER}" patched_source)
string(REPLACE "\r\n" "\n" logical_patched_source "${patched_source}")
string(SHA256 patched_sha256 "${logical_patched_source}")
if(NOT patched_sha256 STREQUAL "9e6849f8933e3e434c5964f78f2c7229537a9398f1d6ded35a2cd2c5d1839501")
  message(FATAL_ERROR "Unexpected patched HiGHS clock accessor hash: ${patched_sha256}")
endif()
if(patched_source MATCHES "\r\n")
  set(line_ending "\r\n")
else()
  set(line_ending "\n")
endif()
set(original_declaration "  HighsInt getNumSchedulerThreads() const { return max_threads; }")
set(clock_declaration "  struct ClockRecordForDiagnostics {\n    HighsInt id;\n    std::string name;\n    HighsInt calls;\n    double seconds;\n  };\n\n  std::vector<ClockRecordForDiagnostics> getClockRecordsForDiagnostics() const {\n    std::vector<ClockRecordForDiagnostics> records;\n    records.reserve(static_cast<size_t>(timer_.num_clock));\n    for (HighsInt id = 0; id < timer_.num_clock; ++id)\n      records.push_back({id, timer_.clock_names[id], timer_.clock_num_call[id],\n                         timer_.read(id)});\n    return records;\n  }")
string(REPLACE "\n" "${line_ending}" clock_declaration "${clock_declaration}")
set(patched_declaration "${original_declaration}${line_ending}${line_ending}${clock_declaration}")
string(FIND "${patched_source}" "${patched_declaration}" declaration_position)
if(declaration_position EQUAL -1)
  message(FATAL_ERROR "Patched HiGHS clock accessor is missing")
endif()
string(REPLACE "${patched_declaration}" "${original_declaration}" upstream_source "${patched_source}")
string(REPLACE "\r\n" "\n" logical_upstream_source "${upstream_source}")
string(SHA256 upstream_sha256 "${logical_upstream_source}")
if(NOT upstream_sha256 STREQUAL "5e81b644fad40522a62037b0dab8ae0f023a8f7db7540297030ac28de58b56cc")
  message(FATAL_ERROR "Reconstructed HiGHS clock patch base hash mismatch: ${upstream_sha256}")
endif()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
set(test_header "${WORK_DIR}/Highs.h")
file(WRITE "${test_header}" "${upstream_source}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_FILE=${test_header}"
  -P "${PATCH_SCRIPT}" RESULT_VARIABLE first_result OUTPUT_VARIABLE first_output ERROR_VARIABLE first_error)
if(NOT first_result EQUAL 0)
  message(FATAL_ERROR "Initial HiGHS clock patch failed: ${first_output}${first_error}")
endif()
file(READ "${test_header}" first_source)
string(REPLACE "\r\n" "\n" logical_first_source "${first_source}")
string(SHA256 first_sha256 "${logical_first_source}")
if(NOT first_sha256 STREQUAL patched_sha256)
  message(FATAL_ERROR "Initial clock patch differs from configured postimage: ${first_sha256}")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_FILE=${test_header}"
  -P "${PATCH_SCRIPT}" RESULT_VARIABLE repeat_result OUTPUT_VARIABLE repeat_output ERROR_VARIABLE repeat_error)
if(NOT repeat_result EQUAL 0)
  message(FATAL_ERROR "Repeated HiGHS clock patch failed: ${repeat_output}${repeat_error}")
endif()
file(READ "${test_header}" repeated_source)
if(NOT repeated_source STREQUAL first_source)
  message(FATAL_ERROR "Repeated clock patch changed the pinned HiGHS header")
endif()

file(APPEND "${test_header}" "\n// unexpected mutation\n")
file(SHA256 "${test_header}" tampered_sha256)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_FILE=${test_header}"
  -P "${PATCH_SCRIPT}" RESULT_VARIABLE tampered_result OUTPUT_VARIABLE tampered_output ERROR_VARIABLE tampered_error)
if(tampered_result EQUAL 0)
  message(FATAL_ERROR "HiGHS clock patch accepted unexpected source drift")
endif()
file(SHA256 "${test_header}" after_rejection_sha256)
if(NOT after_rejection_sha256 STREQUAL tampered_sha256)
  message(FATAL_ERROR "Rejected HiGHS clock patch changed the unexpected source")
endif()
