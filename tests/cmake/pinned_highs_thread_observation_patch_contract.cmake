if(NOT DEFINED UPSTREAM_HEADER OR NOT EXISTS "${UPSTREAM_HEADER}")
  message(FATAL_ERROR "Pinned HiGHS header is missing")
endif()
if(NOT DEFINED PATCH_SCRIPT OR NOT EXISTS "${PATCH_SCRIPT}")
  message(FATAL_ERROR "Pinned HiGHS patch script is missing")
endif()
if(NOT DEFINED WORK_DIR)
  message(FATAL_ERROR "WORK_DIR is required")
endif()

file(READ "${UPSTREAM_HEADER}" patched_source)
string(REPLACE "\r\n" "\n" logical_source "${patched_source}")
string(SHA256 patched_sha256 "${logical_source}")
if(NOT patched_sha256 STREQUAL "5e81b644fad40522a62037b0dab8ae0f023a8f7db7540297030ac28de58b56cc")
  message(FATAL_ERROR "Unexpected patched HiGHS header hash: ${patched_sha256}")
endif()

set(patched_declaration "  static void resetGlobalScheduler(bool blocking = false);")
if(patched_source MATCHES "\r\n")
  set(line_ending "\r\n")
else()
  set(line_ending "\n")
endif()
set(original_declaration "  static void resetGlobalScheduler(bool blocking = false);${line_ending}${line_ending}  // Returns the scheduler width recorded by the most recent optimizeModel call.${line_ending}  HighsInt getNumSchedulerThreads() const { return max_threads; }")
string(FIND "${patched_source}" "${original_declaration}" declaration_position)
if(declaration_position EQUAL -1)
  message(FATAL_ERROR "Patched HiGHS scheduler accessor is missing")
endif()
string(REPLACE "${original_declaration}" "${patched_declaration}" upstream_source "${patched_source}")
string(REPLACE "\r\n" "\n" logical_upstream "${upstream_source}")
string(SHA256 upstream_sha256 "${logical_upstream}")
if(NOT upstream_sha256 STREQUAL "f1b8e2e3f59d9bb96170574e81e9cfc464a16ecfaf1e7ccc64575798ecfb98e2")
  message(FATAL_ERROR "Reconstructed upstream HiGHS header hash mismatch: ${upstream_sha256}")
endif()

file(REMOVE_RECURSE "${WORK_DIR}")
file(MAKE_DIRECTORY "${WORK_DIR}")
set(test_header "${WORK_DIR}/Highs.h")
file(WRITE "${test_header}" "${upstream_source}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_FILE=${test_header}"
  -P "${PATCH_SCRIPT}" RESULT_VARIABLE first_result OUTPUT_VARIABLE first_output ERROR_VARIABLE first_error)
if(NOT first_result EQUAL 0)
  message(FATAL_ERROR "Initial pinned HiGHS accessor patch failed: ${first_output}${first_error}")
endif()
file(SHA256 "${test_header}" first_sha256)
file(SHA256 "${UPSTREAM_HEADER}" expected_file_sha256)
if(NOT first_sha256 STREQUAL expected_file_sha256)
  message(FATAL_ERROR "Patch result differs from configured HiGHS header: ${first_sha256}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_FILE=${test_header}"
  -P "${PATCH_SCRIPT}" RESULT_VARIABLE repeat_result OUTPUT_VARIABLE repeat_output ERROR_VARIABLE repeat_error)
if(NOT repeat_result EQUAL 0)
  message(FATAL_ERROR "Repeated pinned HiGHS accessor patch failed: ${repeat_output}${repeat_error}")
endif()
file(SHA256 "${test_header}" repeat_sha256)
if(NOT repeat_sha256 STREQUAL first_sha256)
  message(FATAL_ERROR "Repeated patch changed the pinned HiGHS header")
endif()

file(APPEND "${test_header}" "\n// unexpected mutation\n")
file(SHA256 "${test_header}" tampered_sha256)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_FILE=${test_header}"
  -P "${PATCH_SCRIPT}" RESULT_VARIABLE tampered_result OUTPUT_VARIABLE tampered_output ERROR_VARIABLE tampered_error)
if(tampered_result EQUAL 0)
  message(FATAL_ERROR "Pinned HiGHS accessor patch accepted an unexpected source hash")
endif()
file(SHA256 "${test_header}" after_rejection_sha256)
if(NOT after_rejection_sha256 STREQUAL tampered_sha256)
  message(FATAL_ERROR "Rejected pinned HiGHS patch changed the unexpected source")
endif()
