{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csl:comparison_spec:3",
  "title": "CSL comparison specification with validated environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "problem_id", "request_digest", "arms", "repetitions", "input_manifest_hash", "input_manifest_source", "environment"],
  "properties": {
    "schema": {"const": "csl.comparison-spec/3"},
    "problem_id": {"type": "string", "pattern": "^csl\\.problem\\.v1\\.sha256:[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arms": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["configuration_id", "strategy", "instrumentation"], "properties": {
        "configuration_id": {"type": "string", "pattern": "^csl\\.config\\.v1\\.sha256:[0-9a-f]{64}$"},
        "strategy": {"type": "string", "minLength": 1}, "instrumentation": {"enum": ["enabled", "disabled"]}}}},
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "input_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_manifest_source": {"enum": ["resolved-problem-canonical-bytes", "csl.exp05-finite-minimax-case/1", "csl.mpc03-b08-case/1"]},
    "environment": {"$ref": "#/$defs/environment"}
  },
  "$defs": {
    "fact": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {"status": {"const": "available"}, "value": {} }},
      {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unavailable"}, "reason": {"type": "string", "minLength": 1} }}]},
    "environment": {"type": "object", "additionalProperties": false, "required": ["schema", "build", "runtime", "execution"], "properties": {
      "schema": {"const": "csl.obs04-environment/1"},
      "build": {"type": "object", "additionalProperties": false, "required": ["schema", "source_revision", "source_tree_sha256", "source_snapshot_method", "source_dirty", "compiler_id", "compiler_version", "generator", "architecture", "build_type", "cxx_standard", "c_flags_sha256", "cxx_flags_sha256", "executable_link_flags_sha256", "target_flags_sha256", "backends"], "properties": {
        "schema": {"const": "csl.obs04-build/1"}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_snapshot_method": {"type": "string", "minLength": 1}, "source_dirty": {"type": "boolean"},
        "compiler_id": {"type": "string", "minLength": 1}, "compiler_version": {"type": "string", "minLength": 1}, "generator": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}, "build_type": {"type": "string", "minLength": 1}, "cxx_standard": {"type": "string", "minLength": 1},
        "c_flags_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "cxx_flags_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executable_link_flags_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "target_flags_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "backends": {"type": "object"}}},
      "runtime": {"type": "object", "additionalProperties": false, "required": ["schema", "binary_sha256", "os_family", "os_version", "kernel", "architecture", "cpu_model", "logical_cpus"], "properties": {
        "schema": {"const": "csl.obs04-runtime/1"}, "binary_sha256": {"$ref": "#/$defs/fact"}, "os_family": {"type": "string", "minLength": 1},
        "os_version": {"$ref": "#/$defs/fact"}, "kernel": {"$ref": "#/$defs/fact"}, "architecture": {"type": "string", "minLength": 1},
        "cpu_model": {"$ref": "#/$defs/fact"}, "logical_cpus": {"$ref": "#/$defs/fact"}}},
      "execution": {"type": "object", "additionalProperties": false, "required": ["requested_workers", "observed_driver_workers", "requested_backend_threads", "observed_backend_threads", "workspace_policy", "cache_policy", "warmup_repetitions", "seed_policy", "tolerances"], "properties": {
        "requested_workers": {"type": "integer", "minimum": 1}, "observed_driver_workers": {"const": 1}, "requested_backend_threads": {"type": "integer", "minimum": 1},
        "observed_backend_threads": {"$ref": "#/$defs/fact"}, "workspace_policy": {"type": "string"}, "cache_policy": {"type": "string"}, "warmup_repetitions": {"const": 1},
        "seed_policy": {"type": "object", "required": ["kind", "reason"], "properties": {"kind": {"const": "not_applicable"}, "reason": {"type": "string"}}},
        "tolerances": {"type": "object", "required": ["absolute", "relative"], "properties": {"absolute": {"type": "number", "minimum": 0}, "relative": {"type": "number", "minimum": 0}}}}}}}
  }
}
