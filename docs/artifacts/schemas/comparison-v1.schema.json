{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csl:comparison:1",
  "title": "CSL inert recorded comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "spec", "spec_digest", "attempts"],
  "properties": {
    "schema": {"const": "csl.comparison/1"},
    "spec": {"type": "string", "description": "Canonical csl.comparison-spec/1 JSON bytes with a problem_id, request_digest, ordered strategy identities, and repetitions."},
    "spec_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "attempts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["strategy_index", "repetition_index", "reported_status", "run_id", "run_digest", "run"],
        "properties": {
          "strategy_index": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "repetition_index": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "reported_status": {"enum": ["completed", "failed", "refused", "unsupported", "timed_out", "cancelled", "resource_limited", "incomplete"], "description": "Must match the terminal kind/reason stored in the embedded run record."},
          "run_id": {"type": "string", "minLength": 1},
          "run_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "run": {"type": "string", "description": "Canonical csl.run-statistics/5, /6, /7 or /9 JSON; always imported as unverified recorded data."}
        }
      }
    }
  }
}
