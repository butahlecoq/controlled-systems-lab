{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csl:comparison-spec:2",
  "title": "CSL comparison specification with owned input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "problem_id", "request_digest", "arms", "repetitions", "input_manifest_hash", "input_manifest_source"],
  "properties": {
    "schema": {"const": "csl.comparison-spec/2"},
    "problem_id": {"type": "string", "pattern": "^csl\\.problem\\.v1\\.sha256:[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["configuration_id", "strategy", "instrumentation"],
        "properties": {
          "configuration_id": {"type": "string", "pattern": "^csl\\.config\\.v1\\.sha256:[0-9a-f]{64}$"},
          "strategy": {"type": "string", "minLength": 1},
          "instrumentation": {"enum": ["enabled", "disabled"]}
        }
      }
    },
    "repetitions": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "input_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_manifest_source": {"enum": ["resolved-problem-canonical-bytes", "csl.exp05-finite-minimax-case/1"]}
  }
}
