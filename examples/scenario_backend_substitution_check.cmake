if(NOT DEFINED SCENARIO_BACKEND_SUBSTITUTION OR NOT DEFINED HIGHS_SCENARIO OR
   NOT DEFINED PHASE_ONE_SCENARIO OR NOT DEFINED OUTPUT_DIRECTORY)
  message(FATAL_ERROR "Scenario backend substitution check requires executable, scenarios, and output directory")
endif()

file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}")
file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
set(highs_output "${OUTPUT_DIRECTORY}/highs.json")
set(phase_one_output "${OUTPUT_DIRECTORY}/phase-one.json")
execute_process(COMMAND "${SCENARIO_BACKEND_SUBSTITUTION}" "${HIGHS_SCENARIO}" "${highs_output}"
  RESULT_VARIABLE highs_status OUTPUT_VARIABLE highs_stdout ERROR_VARIABLE highs_stderr)
if(NOT "${highs_status}" STREQUAL "0")
  message(FATAL_ERROR "HiGHS scenario fixture failed: ${highs_stdout}${highs_stderr}")
endif()
execute_process(COMMAND "${SCENARIO_BACKEND_SUBSTITUTION}" "${PHASE_ONE_SCENARIO}" "${phase_one_output}"
  RESULT_VARIABLE phase_one_status OUTPUT_VARIABLE phase_one_stdout ERROR_VARIABLE phase_one_stderr)
if(NOT "${phase_one_status}" STREQUAL "0")
  message(FATAL_ERROR "Phase I scenario fixture failed: ${phase_one_stdout}${phase_one_stderr}")
endif()

file(READ "${highs_output}" highs)
file(READ "${phase_one_output}" phase_one)
foreach(artifact IN ITEMS highs phase_one)
  string(JSON schema GET "${${artifact}}" schema)
  string(JSON problem GET "${${artifact}}" problem)
  string(JSON requested GET "${${artifact}}" requested_backend)
  string(JSON effective GET "${${artifact}}" effective_backend id)
  string(JSON version GET "${${artifact}}" effective_backend version)
  string(JSON profile GET "${${artifact}}" effective_configuration profile)
  string(JSON absolute_tolerance GET "${${artifact}}" effective_configuration absolute_tolerance)
  string(JSON relative_tolerance GET "${${artifact}}" effective_configuration relative_tolerance)
  string(JSON threads GET "${${artifact}}" effective_configuration threads)
  string(JSON outcome GET "${${artifact}}" outcome)
  string(JSON scope GET "${${artifact}}" evidence_scope)
  string(LENGTH "${version}" version_length)
  if(NOT "${schema}" STREQUAL "csl.scenario-backend-feasibility/1" OR
     NOT "${requested}" STREQUAL "${effective}" OR version_length EQUAL 0 OR
     NOT "${profile}" STREQUAL "zero-objective-equality-feasibility" OR
     NOT "${absolute_tolerance}" MATCHES "^1e-0?8$" OR
     NOT "${relative_tolerance}" MATCHES "^1e-0?8$" OR NOT "${threads}" STREQUAL "1" OR
     NOT "${outcome}" STREQUAL "feasible" OR
     NOT "${scope}" STREQUAL "numerical feasibility witness; no optimality or complete-family claim")
    message(FATAL_ERROR "${artifact} artifact does not record its effective provider and limited evidence")
  endif()
endforeach()
string(JSON highs_problem GET "${highs}" problem)
string(JSON phase_one_problem GET "${phase_one}" problem)
if(NOT "${highs_problem}" STREQUAL "${phase_one_problem}")
  message(FATAL_ERROR "Backend substitution changed ProblemId: ${highs_problem} != ${phase_one_problem}")
endif()
string(JSON highs_backend GET "${highs}" effective_backend id)
string(JSON phase_one_backend GET "${phase_one}" effective_backend id)
if(NOT "${highs_backend}" STREQUAL "csl.lp.highs" OR
   NOT "${phase_one_backend}" STREQUAL "phase-one-bland")
  message(FATAL_ERROR "Scenario-authored settings did not execute both providers")
endif()
string(JSON highs_source GET "${highs}" scenario_source_sha256)
string(JSON phase_one_source GET "${phase_one}" scenario_source_sha256)
if("${highs_source}" STREQUAL "${phase_one_source}")
  message(FATAL_ERROR "The saved runs do not bind their separate scenario-authored backend settings")
endif()
string(JSON highs_sum GET "${highs}" terminal_sum)
string(JSON phase_one_sum GET "${phase_one}" terminal_sum)
if(highs_sum LESS 0.99999999 OR highs_sum GREATER 1.00000001 OR
   phase_one_sum LESS 0.99999999 OR phase_one_sum GREATER 1.00000001)
  message(FATAL_ERROR "A saved witness does not satisfy the independent terminal equation")
endif()
file(READ "${PHASE_ONE_SCENARIO}" fixture_source)
string(JSON unknown_backend SET "${fixture_source}" run backends lp id "\"future-lp\"")
set(unknown_scenario "${OUTPUT_DIRECTORY}/unknown-backend.json")
set(unknown_output "${OUTPUT_DIRECTORY}/unknown-backend-output.json")
file(WRITE "${unknown_scenario}" "${unknown_backend}")
execute_process(COMMAND "${SCENARIO_BACKEND_SUBSTITUTION}" "${unknown_scenario}" "${unknown_output}"
  RESULT_VARIABLE unknown_status OUTPUT_VARIABLE unknown_stdout ERROR_VARIABLE unknown_stderr)
if(NOT "${unknown_status}" STREQUAL "2" OR
   NOT "${unknown_stderr}" MATCHES "path=/run/backends/lp observed=future-lp")
  message(FATAL_ERROR "Unknown provider was not refused with a backend-field diagnostic: ${unknown_stdout}${unknown_stderr}")
endif()
string(JSON changed_model SET "${fixture_source}" model A "[[2]]")
set(changed_scenario "${OUTPUT_DIRECTORY}/changed-math.json")
set(changed_output "${OUTPUT_DIRECTORY}/changed-math-output.json")
file(WRITE "${changed_scenario}" "${changed_model}")
execute_process(COMMAND "${SCENARIO_BACKEND_SUBSTITUTION}" "${changed_scenario}" "${changed_output}"
  RESULT_VARIABLE changed_status OUTPUT_VARIABLE changed_stdout ERROR_VARIABLE changed_stderr)
if(NOT "${changed_status}" STREQUAL "2" OR
   NOT "${changed_stderr}" MATCHES "path=/scenario/model")
  message(FATAL_ERROR "The provider fixture accepted altered scenario math: ${changed_stdout}${changed_stderr}")
endif()
string(REGEX MATCH "observed_problem=([^ ]+)" changed_problem_match "${changed_stderr}")
if(NOT changed_problem_match)
  message(FATAL_ERROR "The changed-math diagnostic omitted its computed ProblemId: ${changed_stderr}")
endif()
set(changed_problem "${CMAKE_MATCH_1}")
string(JSON fixture_problem GET "${highs}" problem)
if("${changed_problem}" STREQUAL "${fixture_problem}")
  message(FATAL_ERROR "Changing mathematical data did not change ProblemId: ${fixture_problem}")
endif()
file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}")
