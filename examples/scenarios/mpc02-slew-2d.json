{
  "schema": "csl.scenario/2",
  "id": "mpc02-slew-2d-v1",
  "horizon": 2,
  "model": {"kind": "linear_discrete_ltv", "stages": [
    {"A": [[1, 0], [0, 1]], "B": [[1], [0]]},
    {"A": [[1, 0], [0, 1]], "B": [[0], [1]]}
  ]},
  "initial_state": [0, 0],
  "controls": {"kind": "box", "lower": [-1], "upper": [1]},
  "objective": {"kind": "quadratic", "Q": [[2, 0], [0, 2]], "linear": [-1, 0], "offset": 0.25},
  "temporal": {
    "coordinate_order": "x0,...,xT,u0,...,u(T-1)",
    "rows": [[0, 0, 0, 0, 0, 0, -1, 1]],
    "bounds": [{"lower": -0.25, "upper": 0.25}]
  },
  "metadata": {
    "title": "MPC-02 one-step slew two-stage integrator",
    "description": "The same stage-box problem with the cross-time constraint |u_1-u_0| <= 1/4.",
    "state_labels": ["x_1", "x_2"],
    "control_labels": ["u"],
    "state_units": ["dimensionless", "dimensionless"],
    "control_units": ["dimensionless"],
    "time_unit": "stage"
  }
}
