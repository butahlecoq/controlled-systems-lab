{
  "schema": "csl.scenario/2",
  "id": "temporal-slew-integrator",
  "horizon": 2,
  "model": {"kind": "linear_discrete", "A": [[1]], "B": [[1]]},
  "initial_state": [0],
  "controls": {"kind": "box", "lower": [-1], "upper": [1]},
  "objective": {"kind": "quadratic", "Q": [[2]], "linear": [0], "offset": 0},
  "temporal": {
    "coordinate_order": "x0,...,xT,u0,...,u(T-1)",
    "rows": [[0, 0, 0, -1, 1]],
    "bounds": [{"lower": -0.25, "upper": 0.25}]
  },
  "metadata": {
    "title": "Two-step integrator with a slew limit",
    "description": "A scalar two-step integrator. The input-rate constraint couples both control stages.",
    "state_labels": ["x"],
    "control_labels": ["u"],
    "state_units": ["dimensionless"],
    "control_units": ["dimensionless"],
    "time_unit": "stage"
  }
}
