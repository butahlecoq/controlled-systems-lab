if(NOT DEFINED EXAMPLE_EXE OR NOT DEFINED OUTPUT_PARENT)
  message(FATAL_ERROR "EXAMPLE_EXE and OUTPUT_PARENT are required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef attempt_id)
set(output "${OUTPUT_PARENT}/quadcopter-mpc-${attempt_id}")
execute_process(COMMAND "${EXAMPLE_EXE}" "${output}"
  RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Source21 functional MPC failed; result is preserved at ${output}: ${stdout}${stderr}")
endif()
if(NOT "${stdout}" MATCHES "15 checked feedback replans; backend=csl.convex.highs version=")
  message(FATAL_ERROR "Unexpected source21 solver outcome: ${stdout}")
endif()
if(NOT EXISTS "${output}/plans.csv" OR NOT EXISTS "${output}/run.txt")
  message(FATAL_ERROR "Source21 records missing from ${output}")
endif()
file(STRINGS "${output}/plans.csv" plan_rows)
list(LENGTH plan_rows row_count)
if(NOT row_count EQUAL 3046)
  message(FATAL_ERROR "Expected 3046 plan CSV lines, observed ${row_count}; result is preserved at ${output}")
endif()
file(READ "${output}/run.txt" run_record)
if(NOT run_record MATCHES "feedback_replans=15" OR
   NOT run_record MATCHES "fixed_external_input=zero" OR
   NOT run_record MATCHES "outcome=numerical_optimal; no certified bounds or global feedback-policy claim")
  message(FATAL_ERROR "Source21 run metadata is incomplete; result is preserved at ${output}")
endif()
