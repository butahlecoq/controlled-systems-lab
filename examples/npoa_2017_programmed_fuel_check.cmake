file(MAKE_DIRECTORY "${OUTPUT_DIRECTORY}")
execute_process(COMMAND "${EXAMPLE_EXE}" "${OUTPUT_DIRECTORY}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Fuel optimization failed: ${output}${error}")
endif()
if(NOT "${output}" MATCHES "oracle=terminal-affine-hull-lower-bound-attained-by-feasible-witness")
  message(FATAL_ERROR "The run must report its independent optimum qualification: ${output}")
endif()
if(NOT "${output}" MATCHES "article_reported_objective=4.6608 article_minus_oracle=0.0112")
  message(FATAL_ERROR "The independent result must retain the article comparison: ${output}")
endif()
file(STRINGS "${OUTPUT_DIRECTORY}/trajectory.csv" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 12)
  message(FATAL_ERROR "Expected one header and 11 stage rows, observed ${row_count}")
endif()
list(GET rows 0 header)
if(NOT "${header}" STREQUAL "stage,x1,x2,x3,x4")
  message(FATAL_ERROR "Unexpected trajectory columns: ${header}")
endif()
message(STATUS "${output}")
foreach(figure reachable-x1-x2.svg reachable-x3-x4.svg)
  if(NOT EXISTS "${OUTPUT_DIRECTORY}/${figure}")
    message(FATAL_ERROR "Missing projection figure ${figure}")
  endif()
endforeach()
