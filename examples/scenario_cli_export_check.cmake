if(NOT DEFINED SCENARIO_CLI OR NOT DEFINED SCENARIO_INPUT OR NOT DEFINED OUTPUT_DIRECTORY)
  message(FATAL_ERROR "Scenario CLI export test requires its executable, input, and output directory")
endif()
if(NOT DEFINED EXPECTED_FAMILY_KIND)
  set(EXPECTED_FAMILY_KIND "complete")
endif()
set(profile_arguments)
if(DEFINED SCENARIO_PROFILE)
  list(APPEND profile_arguments --profile "${SCENARIO_PROFILE}")
endif()

file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}")
execute_process(
  COMMAND "${SCENARIO_CLI}" --run "${SCENARIO_INPUT}" ${profile_arguments} --output-dir "${OUTPUT_DIRECTORY}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Scenario CLI export failed (${status}): ${output}${error}")
endif()

foreach(name IN ITEMS reach-back strategy-b)
  set(path "${OUTPUT_DIRECTORY}/${name}.run.json")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Scenario CLI did not publish ${path}")
  endif()
  file(READ "${path}" artifact)
  string(JSON schema GET "${artifact}" schema)
  string(JSON state GET "${artifact}" recorded_state)
  string(JSON final_kind GET "${artifact}" final kind)
  if(NOT "${schema}" STREQUAL "csl.run-statistics/7")
    message(FATAL_ERROR "${path} uses unexpected schema ${schema}")
  endif()
  if(NOT "${state}" STREQUAL "unverified_recorded_data")
    message(FATAL_ERROR "${path} does not declare its untrusted recorded state")
  endif()
  if(NOT "${final_kind}" STREQUAL "synthesis")
    message(FATAL_ERROR "${path} does not preserve a synthesis attempt")
  endif()
  if(NOT (EXPECTED_FAMILY_KIND STREQUAL "candidate" AND name STREQUAL "reach-back"))
    string(JSON family_kind GET "${artifact}" final value family family outcome kind)
    if(NOT "${family_kind}" STREQUAL "${EXPECTED_FAMILY_KIND}")
    message(FATAL_ERROR "${path} did not preserve family kind ${EXPECTED_FAMILY_KIND} as recorded data")
    endif()
  endif()
  if(EXPECTED_FAMILY_KIND STREQUAL "candidate" AND name STREQUAL "strategy-b")
    string(JSON profile GET "${artifact}" final value family family identity request profile)
    string(JSON target GET "${artifact}" final value family family identity request target)
    string(JSON assurance GET "${artifact}" final value family family identity request assurance)
    string(JSON representation GET "${artifact}" final value family family identity request representation)
    if(NOT "${profile}" STREQUAL "nominal_open_loop" OR NOT "${target}" STREQUAL "candidate_relaxation" OR
       NOT "${assurance}" STREQUAL "numerical" OR NOT "${representation}" STREQUAL "csl.polyhedron.h")
      message(FATAL_ERROR "${path} does not retain the authored candidate run request")
    endif()
  endif()
  if(EXPECTED_FAMILY_KIND STREQUAL "candidate" AND name STREQUAL "reach-back")
    string(JSON termination TYPE "${artifact}" final value termination)
    if(NOT "${termination}" STREQUAL "STRING")
      message(FATAL_ERROR "The reach-back attempt outcome was not preserved")
    endif()
  elseif(EXPECTED_FAMILY_KIND STREQUAL "candidate")
    string(JSON termination GET "${artifact}" final value termination)
    string(JSON outcome GET "${artifact}" final value outcome value)
    string(JSON incumbents LENGTH "${artifact}" final value incumbents)
    if(NOT "${termination}" STREQUAL "completed" OR NOT "${outcome}" STREQUAL "undetermined" OR NOT incumbents EQUAL 1)
      message(FATAL_ERROR "Strategy B must preserve its undetermined candidate and one feasible incumbent")
    endif()
    string(JSON objective GET "${artifact}" final value incumbents 0 witness original_objective)
    string(JSON final_position GET "${artifact}" final value incumbents 0 witness states 3 0)
    string(JSON final_velocity GET "${artifact}" final value incumbents 0 witness states 3 1)
    string(JSON verifier GET "${artifact}" final value incumbents 0 feasibility support value verifier)
    string(JSON max_residual GET "${artifact}" final value incumbents 0 feasibility support value max_residual)
    string(JSON absolute_tolerance GET "${artifact}" final value incumbents 0 feasibility support value absolute_tolerance)
    string(JSON u0 GET "${artifact}" final value incumbents 0 witness controls 0 0)
    string(JSON u1 GET "${artifact}" final value incumbents 0 witness controls 1 0)
    string(JSON u2 GET "${artifact}" final value incumbents 0 witness controls 2 0)
    if("${objective}" LESS -1e-12 OR "${objective}" GREATER 1e-12 OR
       "${final_position}" LESS 0.999999999 OR "${final_position}" GREATER 1.000000001 OR
       "${final_velocity}" LESS 0.499999999 OR "${final_velocity}" GREATER 0.500000001 OR
       NOT "${verifier}" STREQUAL "csl.trajectory.original" OR
       "${u0}" LESS -1e-12 OR "${u0}" GREATER 1e-12 OR
       "${u1}" LESS 0.749999999 OR "${u1}" GREATER 0.750000001 OR
       "${u2}" LESS -0.250000001 OR "${u2}" GREATER -0.249999999)
      message(FATAL_ERROR "The Strategy B incumbent does not match the independent dynamics/objective oracle")
    endif()
    if(max_residual GREATER absolute_tolerance)
      message(FATAL_ERROR "The Strategy B incumbent's recorded residual exceeds its tolerance")
    endif()
  else()
    string(JSON attachment_count LENGTH "${artifact}" attachments)
    set(has_h_relation_attachment FALSE)
    if(attachment_count GREATER 0)
      math(EXPR last_attachment "${attachment_count} - 1")
      foreach(index RANGE 0 ${last_attachment})
        string(JSON attachment_schema GET "${artifact}" attachments ${index} schema)
        if("${attachment_schema}" STREQUAL "csl.h-relation-attachment/1")
          set(has_h_relation_attachment TRUE)
        endif()
      endforeach()
    endif()
    if(NOT has_h_relation_attachment)
      message(FATAL_ERROR "${path} has no versioned H-relation attachment")
    endif()
  endif()
endforeach()

file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}")
