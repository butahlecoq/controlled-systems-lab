if(NOT DEFINED SCENARIO_CLI OR NOT DEFINED SCENARIO_INPUT OR NOT DEFINED OUTPUT_DIRECTORY)
  message(FATAL_ERROR "Scenario CLI export test requires its executable, input, and output directory")
endif()

file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}")
execute_process(
  COMMAND "${SCENARIO_CLI}" --run "${SCENARIO_INPUT}" --output-dir "${OUTPUT_DIRECTORY}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Scenario CLI export failed (${status}): ${output}${error}")
endif()

foreach(name IN ITEMS reach-back strategy-b)
  set(path "${OUTPUT_DIRECTORY}/${name}.run.json")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "Scenario CLI did not publish ${path}")
  endif()
  file(READ "${path}" artifact)
  string(JSON schema GET "${artifact}" schema)
  string(JSON state GET "${artifact}" recorded_state)
  string(JSON final_kind GET "${artifact}" final kind)
  string(JSON family_kind GET "${artifact}" final value family family outcome kind)
  if(NOT "${schema}" STREQUAL "csl.run-statistics/5")
    message(FATAL_ERROR "${path} uses unexpected schema ${schema}")
  endif()
  if(NOT "${state}" STREQUAL "unverified_recorded_data")
    message(FATAL_ERROR "${path} does not declare its untrusted recorded state")
  endif()
  if(NOT "${final_kind}" STREQUAL "synthesis" OR NOT "${family_kind}" STREQUAL "complete")
    message(FATAL_ERROR "${path} did not preserve its complete-family claim as recorded data")
  endif()
  string(JSON attachment_schema GET "${artifact}" attachments 0 schema)
  if(NOT "${attachment_schema}" STREQUAL "csl.h-relation-attachment/1")
    message(FATAL_ERROR "${path} has no versioned H-relation attachment")
  endif()
endforeach()

file(REMOVE_RECURSE "${OUTPUT_DIRECTORY}")
