if(NOT DEFINED EXAMPLE_EXE OR NOT DEFINED OUTPUT_PARENT)
  message(FATAL_ERROR "EXAMPLE_EXE and OUTPUT_PARENT are required")
endif()
set(output_directory "${OUTPUT_PARENT}/discrete-mpc-2d-test-output")
file(REMOVE_RECURSE "${output_directory}")
execute_process(COMMAND "${EXAMPLE_EXE}" "${output_directory}"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${status}" STREQUAL "0")
  message(FATAL_ERROR "Native matched MPC example failed: ${status}: ${output}${error}")
endif()
if(NOT "${output}" MATCHES "Matched open-loop/MPC episodes agree; declared replay disturbance changes a later observed-state MPC action")
  message(FATAL_ERROR "Unexpected native episode summary: ${output}")
endif()
file(READ "${output_directory}/episode.csv" csv)
if(NOT csv MATCHES "forecast-zero-replay-disturbed,open-loop,1,control" OR
   NOT csv MATCHES "forecast-zero-replay-disturbed,observed-mpc,1,control")
  message(FATAL_ERROR "Native replay evidence is missing from episode.csv")
endif()
message(STATUS "${output}")
