set(csl_nominal_header_targets)
foreach(module nominal_forward nominal_predecessor nominal_tube)
  set(header "reachability/${module}.hpp")
  string(MAKE_C_IDENTIFIER "${header}" header_name)
  set(source "${CMAKE_CURRENT_BINARY_DIR}/header-checks/${header_name}.cpp")
  file(GENERATE OUTPUT "${source}" CONTENT "#include <csl/${header}>\n")
  add_library(header_${header_name} OBJECT "${source}")
  if(module STREQUAL nominal_predecessor)
    target_link_libraries(header_${header_name} PRIVATE CSL::polyhedral)
  else()
    target_link_libraries(header_${header_name} PRIVATE CSL::${module})
  endif()
  list(APPEND csl_nominal_header_targets header_${header_name})
endforeach()
add_custom_target(csl_nominal_header_checks DEPENDS ${csl_nominal_header_targets})

