{"schema":"csl.synthesis.paired-family-event/1","event":"header","problem":"csl.problem.v1.sha256:5a747aef9d672c53b651b4ff0adf1fa9c937becd5a080d6659a009d69462dec4","scenario_sha256":"00686f585934738530be0c890baa29dc049fa810b2f8fa8f083191da59c2dedb","profile":"ts02_constant_integrator","target":"exact_optimal_relation","representation":"csl.polyhedron.h","assurance":"numerical","resource_policy":{"total_threads":1,"outer_workers":1,"threads_per_worker":1,"memory_bytes":null},"absolute_tolerance":1e-08,"relative_tolerance":1e-08,"shared_setup_ns":{"scenario_load_and_resolution":513059,"provider_and_registry_setup":163221},"shared_setup_scope":"Scenario JSON parse and immutable resolution are timed once; provider registration/selection, strategy and selector registries, and prepared membership provider are timed once. These shared setup values are excluded from per-strategy totals.","order_policy":"One excluded A-then-B warmup pair; 5 measured pairs alternate A/B then B/A. Both members of every pair share this immutable resolved problem and provider registries.","per_strategy_scope":"Fresh StrategyRegistry::prepare through exclusive workspace creation, public StrategyPort run and complete-family acceptance, selector preparation/query returning two distinct histories, and witness-only verification of both histories against the original resolved problem. Excludes process startup, shared scenario/provider setup, JSON serialization/file I/O, build, plots and report rendering.","phase_scope":{"preparation_ns":"StrategyRegistry::prepare including capability admission and immutable plan creation","workspace_creation_ns":"Prepared strategy create through exclusive workspace return","family_construction_ns":"Public workspace run through result return, including the registered exact-profile verifier","selector_preparation_ns":"Selector selection/preparation for this strategy result","selector_workspace_creation_ns":"Prepared selector create through exclusive query workspace return","witness_query_ns":"Selector workspace run and checked batch binding/count","original_verification_ns":"verification::verify_trajectory for both selected witnesses","end_to_end_strategy_ns":"Preparation start through completion of both original-data witness checks; inclusive total, not a sum of other measured phases"},"phase_counters_unavailable":["Internal LP/convex, projection, affine-sum, conversion, hull-membership and verifier subphase durations/call counts are not exposed by these public APIs.","CPU time and per-call peak memory are not measured by this timing driver."]}
