{"schema":"csl.synthesis.paired-family-event/1","event":"header","problem":"csl.problem.v1.sha256:a60e2592cac59f99f8fb11146b19d605168edbbdec2c4f6724ab8e23efaf688b","scenario_sha256":"c63dd94a45b22a557879fbda83dd49938cde9aa4fa24b5f5fc4e2cf0204397d2","profile":"ts03_singular_integrator","target":"exact_optimal_relation","representation":"csl.polyhedron.h","assurance":"numerical","resource_policy":{"total_threads":1,"outer_workers":1,"threads_per_worker":1,"memory_bytes":null},"absolute_tolerance":1e-08,"relative_tolerance":1e-08,"shared_setup_ns":{"scenario_load_and_resolution":898933,"provider_and_registry_setup":232433},"shared_setup_scope":"Scenario JSON parse and immutable resolution are timed once; provider registration/selection, strategy and selector registries, and prepared membership provider are timed once. These shared setup values are excluded from per-strategy totals.","order_policy":"One excluded A-then-B warmup pair; 5 measured pairs alternate A/B then B/A. Both members of every pair share this immutable resolved problem and provider registries.","per_strategy_scope":"Fresh StrategyRegistry::prepare through exclusive workspace creation, public StrategyPort run and complete-family acceptance, selector preparation/query returning two distinct histories, and witness-only verification of both histories against the original resolved problem. Excludes process startup, shared scenario/provider setup, JSON serialization/file I/O, build, plots and report rendering.","phase_scope":{"preparation_ns":"StrategyRegistry::prepare including capability admission and immutable plan creation","workspace_creation_ns":"Prepared strategy create through exclusive workspace return","family_construction_ns":"Public workspace run through result return, including the registered exact-profile verifier","selector_preparation_ns":"Selector selection/preparation for this strategy result","selector_workspace_creation_ns":"Prepared selector create through exclusive query workspace return","witness_query_ns":"Selector workspace run and checked batch binding/count","original_verification_ns":"verification::verify_trajectory for both selected witnesses","end_to_end_strategy_ns":"Preparation start through completion of both original-data witness checks; inclusive total, not a sum of other measured phases"},"phase_counters_unavailable":["Internal LP/convex, projection, affine-sum, conversion, hull-membership and verifier subphase durations/call counts are not exposed by these public APIs.","CPU time and per-call peak memory are not measured by this timing driver."]}
