{
  "schema": "csl.mpc11.nonlinear-request/1",
  "scenario": {
    "schema": "csl.mpc11.scenario/1",
    "track": "new-synthetic-comparison",
    "contract": "docs/contracts/mpc11-synthetic-controller-study.md",
    "assurance": "numerical-binary64",
    "hold": "zero-order",
    "observation": "exact-full-execution-state",
    "variants": [
      "affine-plan/affine-replay",
      "affine-plan/nonlinear-replay",
      "nominal-nmpc/nonlinear-replay"
    ],
    "nmpc": {
      "horizon": "shrinking-to-fixed-terminal",
      "running_cost_denominator": "original-interval-count",
      "physical_constraints": true,
      "affine_trust_region": false,
      "collocation": {
        "method": "radau",
        "degree": 3,
        "elements_per_interval": 1,
        "state_constraint_nodes": "all-collocation-and-mesh-including-endpoints"
      },
      "solver": {
        "name": "ipopt",
        "linear_solver": "mumps",
        "tol": 1e-08,
        "acceptable_tol": 1e-06,
        "max_iter": 1000
      },
      "warm_start": {
        "primal": "drop-first-interval-no-terminal-repeat",
        "dual": "zero-every-solve",
        "initial_state_override": "new-full-observation"
      },
      "failure": "stop-before-next-input-no-fallback",
      "n_robust": 0
    },
    "execution": {
      "method": "cvodes",
      "scaled_abstol": 1e-10,
      "reltol": 1e-09
    },
    "independent_replay": {
      "provider": "CSL::simulation",
      "method": "adaptive-rk4-step-doubling",
      "scaled_abstol": 1e-10,
      "reltol": 1e-09,
      "step_attempts_per_hold_interval": 100000,
      "report_subintervals_per_hold": 20,
      "sensitivity": {
        "scaled_abstol": 1e-11,
        "reltol": 1e-10
      }
    },
    "evidence_limits": [
      "local-NLP-only",
      "sampled-constraints-not-continuous-safety",
      "no-nonlinear-robustness",
      "no-reachable-set-containment",
      "not-historical-restoration"
    ],
    "case_id": "SYN-NL-FUEL-01",
    "model_id": "syn-nl-fuel-01/ode/1",
    "objective_id": "syn-nl-fuel-01/dimensionless-quadratic/1",
    "time": {
      "unit": "s",
      "dt": 0.5,
      "intervals": 1,
      "final": 10.0,
      "grid": [
        9.5,
        10.0
      ],
      "reference_transforms": "physical-coordinates; affine-reference-subtraction-saved-by-producer"
    },
    "states": [
      {
        "name": "m_ox",
        "unit": "kg",
        "initial": 100,
        "scale": 100,
        "physical_bounds": [
          40,
          120
        ]
      },
      {
        "name": "m_f",
        "unit": "kg",
        "initial": 30,
        "scale": 30,
        "physical_bounds": [
          12,
          36
        ]
      },
      {
        "name": "q_ox",
        "unit": "kg/s",
        "initial": 2,
        "scale": 3,
        "physical_bounds": [
          0,
          3
        ]
      },
      {
        "name": "q_f",
        "unit": "kg/s",
        "initial": 0.6,
        "scale": 1,
        "physical_bounds": [
          0,
          1
        ]
      }
    ],
    "controls": [
      {
        "name": "u_ox",
        "unit": "1",
        "physical_bounds": [
          0,
          1
        ]
      },
      {
        "name": "u_f",
        "unit": "1",
        "physical_bounds": [
          0,
          1
        ]
      }
    ],
    "parameters": {
      "Q_ox": {
        "value": 3,
        "unit": "kg/s"
      },
      "Q_f": {
        "value": 1,
        "unit": "kg/s"
      },
      "tau_ox": {
        "value": 2,
        "unit": "s"
      },
      "tau_f": {
        "value": 2,
        "unit": "s"
      },
      "m_ox0": {
        "value": 100,
        "unit": "kg"
      },
      "m_f0": {
        "value": 30,
        "unit": "kg"
      }
    },
    "equations": [
      "dm_ox/dt=-q_ox",
      "dm_f/dt=-q_f",
      "dq_ox/dt=(Q_ox*u_ox*sqrt(m_ox/m_ox0)-q_ox)/tau_ox",
      "dq_f/dt=(Q_f*u_f*sqrt(m_f/m_f0)-q_f)/tau_f"
    ],
    "model_domain": "m_ox,m_f >= 0 and every state/input finite; negative mass raises model-domain error",
    "objective": {
      "terminal_target": [
        75,
        23,
        1.5,
        0.45
      ],
      "terminal_scale": [
        100,
        30,
        3,
        1
      ],
      "terminal_weights": [
        1,
        1,
        0.1,
        0.1
      ],
      "running_weight": 0.02,
      "running_scale": [
        1,
        1
      ],
      "running_reference": "midpoint-sampled-nominal-command",
      "running_formula": "running_weight/N*sum_k(sum_i(((u[k,i]-ubar[k,i])/running_scale[i])^2))",
      "terminal_formula": "sum_i(terminal_weights[i]*((x[N,i]-terminal_target[i])/terminal_scale[i])^2)"
    },
    "affine": {
      "model_id": "syn-nl-fuel-01/midpoint-endpoint-matched-affine/1",
      "linearization": "midpoint-frozen-Jacobians-per-interval; schedule-frozen-at-t0",
      "state_reference": [
        "100-2*t",
        "30-.6*t",
        "2",
        ".6"
      ],
      "input_reference": [
        "2/(3*sqrt((100-2*t)/100))",
        ".6/sqrt((30-.6*t)/30)"
      ],
      "input_reference_sampling": "interval-midpoint-held",
      "reference_domain": [
        0,
        20
      ],
      "discretization": "matrix-exponential-Ad-Bd; cd=xbar[k+1]-Ad*xbar[k]-Bd*ubar[k]",
      "trust_state_absolute": [
        20,
        10,
        1,
        0.3
      ],
      "trust_input_absolute": [
        0.2,
        0.2
      ],
      "producer": "actual-CSL-public-joint-program-or-synthesis; retain-provider-and-witness",
      "offset_coordinates": "physical-state; scale-transform=x/scale; reference-deviation-transform-explicit"
    },
    "initial_guess": {
      "input": "midpoint-sampled-nominal-command",
      "state": "analytic-reference; first-state=observation"
    },
    "controller_id": "syn-nl-fuel-01/nominal-shrinking-radau3/1",
    "parameter_source": "authored-synthetic-design; docs/research/mpc11-nonlinear-study-design.md",
    "figures": {
